# Ghostty 配置
# 文档: https://ghostty.org/docs/config

# 字体：DejaVuSansM Nerd Font Mono（自带 ✓◐○● 等符号字形）
font-family = "DejaVuSansM Nerd Font Mono"
font-family-bold = "DejaVuSansM Nerd Font Mono"
# 回退字体：仓耳云黑，补齐中文字形
font-family = "TsangerYunHei"
font-family-bold = "TsangerYunHei"
font-size = 13
# 字体渲染优化
# macOS 下加粗笔画，缓解细字体发虚
font-thicken = true
font-thicken-strength = 128
# 低对比度前景色自动提亮，暗色主题下更清晰
minimum-contrast = 1.1
# 增加行距，显示更透气
adjust-cell-height = 5%

# 主题: Kitty Default（Ghostty 内置），背景与 nvim vscode 主题一致
theme = Kitty Default
background = 181818

