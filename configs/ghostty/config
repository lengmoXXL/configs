# Ghostty 配置
# 文档: https://ghostty.org/docs/config

# 字体
font-family = "DroidSansM Nerd Font Mono"
font-size = 13
# 字体渲染优化
# macOS 下加粗笔画，缓解细字体发虚
font-thicken = true
font-thicken-strength = 128
# 低对比度前景色自动提亮，暗色主题下更清晰
minimum-contrast = 1.1
# 增加行距，显示更透气
adjust-cell-height = 5%

# 窗口
window-padding-x = 8
window-padding-y = 6
window-decoration = true
macos-titlebar-style = hidden
window-save-state = always
# 查看所有 tab 的总览并切换
keybind = super+shift+o=toggle_tab_overview

# 主题: Kitty Default（Ghostty 内置），背景与 nvim vscode 主题一致
theme = Kitty Default
background = 181818

# 行为
scrollback-limit = 100000
confirm-close-surface = false
quit-after-last-window-closed = true
mouse-hide-while-typing = true
copy-on-select = clipboard
