#!/usr/bin/env bash
set -euo pipefail

socket="${1:-}"
new_pane="${2:-}"

[[ -n "$socket" && -n "$new_pane" ]] || exit 0

pj_name="$(tmux -S "$socket" show-options -p -qv -t ! @pj_name 2>/dev/null || true)"
if [[ -n "$pj_name" ]]; then
    quoted_name="$(printf "%q" "$pj_name")"
    tmux -S "$socket" send-keys -t "$new_pane" "pj $quoted_name" C-m
else
    # pj not enabled — inherit the working directory from the pane being split
    cwd="$(tmux -S "$socket" display-message -p -t ! -F '#{pane_current_path}' 2>/dev/null || true)"
    if [[ -n "$cwd" ]]; then
        quoted_cwd="$(printf "%q" "$cwd")"
        tmux -S "$socket" send-keys -t "$new_pane" "cd $quoted_cwd" C-m
    fi
fi
